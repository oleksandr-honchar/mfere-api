# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mfere_user:mfere_pass@db:5432/mfere








# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=mfere_user
POSTGRES_PASSWORD=mfere_pass
POSTGRES_DB=mfere


# ── FRED API ──────────────────────────────────────────────────────────────────
# Register free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── SEC EDGAR ─────────────────────────────────────────────────────────────────
# No key required. Identify your app per SEC fair-use policy.
SEC_USER_AGENT=MFERE Research your@email.com

# ── Pipeline settings ─────────────────────────────────────────────────────────
# Comma-separated list of tickers to ingest (leave blank for full S&P 500 universe)
TICKER_UNIVERSE=
TICKERS_DEV=^GSPC,AAPL,MSFT,GOOGL,JPM,XOM,JNJ,BRK-B,AMZN,META
# Start date for price history
PRICE_START_DATE=2010-01-01
# Request delay for SEC API (seconds) — do not go below 0.1
SEC_REQUEST_DELAY=0.15
